{
    "name": "rasuvaeff/laravel-mcp",
    "description": "Laravel integration of the rasuvaeff/mcp server",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "laravel",
        "mcp",
        "model-context-protocol",
        "ai",
        "llm"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/laravel-mcp",
    "support": {
        "issues": "https://github.com/rasuvaeff/laravel-mcp/issues",
        "source": "https://github.com/rasuvaeff/laravel-mcp"
    },
    "require": {
        "php": "8.3 - 8.6",
        "laravel/framework": "^12.41 || ^13.0",
        "mcp/sdk": "~0.10.0",
        "nyholm/psr7": "^1.8",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "rasuvaeff/mcp": "^0.1",
        "rasuvaeff/mcp-openapi": "^0.1",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/psr-http-message-bridge": "^7.4 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.17",
        "rasuvaeff/rector-named-literals": "^1.0",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^7.0"
    },
    "suggest": {
        "firebase/php-jwt": "JWT validation for the OAuth guard (^7.0)"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\LaravelMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\LaravelMcp\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\LaravelMcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rasuvaeff\\LaravelMcp\\McpServiceProvider"
            ]
        },
        "skills": {
            "source": "resources/skills"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "infection --threads=max --with-uncovered"
        ],
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml"
    }
}